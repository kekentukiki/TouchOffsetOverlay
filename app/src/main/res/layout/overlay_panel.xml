<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayRoot"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_panel_bg"
    android:orientation="vertical"
    android:padding="10dp"
    android:elevation="12dp">

    <!-- Header (drag handle + collapse) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="⊕ Touch Offset"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCollapse"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="−"
            android:textColor="#BBFFFFFF"
            android:textSize="20sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Collapsible body -->
    <LinearLayout
        android:id="@+id/expandableContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ON / OFF intercept toggle (prominent) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleCapture"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="▶ MULAI OFFSET (sekarang: mati)"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:backgroundTint="#333355"
            android:layout_marginBottom="8dp" />

        <!-- Crosshair preview -->
        <com.touchoffset.overlay.OffsetPreviewView
            android:id="@+id/offsetPreview"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginBottom="6dp" />

        <!-- X / Y coordinates -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="X: " android:textColor="#BBFFFFFF" android:textSize="13sp" />
            <TextView android:id="@+id/overlayTvX"
                android:layout_width="36dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="0"
                android:textColor="#BB86FC" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="  Y: " android:textColor="#BBFFFFFF" android:textSize="13sp" />
            <TextView android:id="@+id/overlayTvY"
                android:layout_width="36dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="0"
                android:textColor="#BB86FC" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Arrow UP -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center">
            <TextView android:id="@+id/btnUp" android:layout_width="48dp" android:layout_height="48dp"
                android:text="▲" android:textSize="22sp" android:textColor="#FFFFFF"
                android:gravity="center" android:background="@drawable/arrow_btn_bg" />
        </LinearLayout>

        <!-- Arrow LEFT + RESET + RIGHT -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
            <TextView android:id="@+id/btnLeft" android:layout_width="48dp" android:layout_height="48dp"
                android:text="◀" android:textSize="22sp" android:textColor="#FFFFFF"
                android:gravity="center" android:background="@drawable/arrow_btn_bg" />
            <TextView android:id="@+id/btnReset"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                android:text="✕" android:textSize="18sp" android:textColor="#BB86FC"
                android:gravity="center" android:background="@drawable/arrow_btn_bg" />
            <TextView android:id="@+id/btnRight" android:layout_width="48dp" android:layout_height="48dp"
                android:text="▶" android:textSize="22sp" android:textColor="#FFFFFF"
                android:gravity="center" android:background="@drawable/arrow_btn_bg" />
        </LinearLayout>

        <!-- Arrow DOWN -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginBottom="8dp">
            <TextView android:id="@+id/btnDown" android:layout_width="48dp" android:layout_height="48dp"
                android:text="▼" android:textSize="22sp" android:textColor="#FFFFFF"
                android:gravity="center" android:background="@drawable/arrow_btn_bg" />
        </LinearLayout>

        <!-- Step selector -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Step:" android:textColor="#AAAAAA" android:textSize="12sp" />
            <TextView android:id="@+id/btnStep1"  android:layout_width="34dp" android:layout_height="28dp"
                android:layout_marginStart="4dp" android:text="1"  android:textSize="11sp"
                android:gravity="center" android:background="@drawable/arrow_btn_bg" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/btnStep5"  android:layout_width="34dp" android:layout_height="28dp"
                android:layout_marginStart="4dp" android:text="5"  android:textSize="11sp"
                android:gravity="center" android:background="@drawable/arrow_btn_bg" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/btnStep10" android:layout_width="34dp" android:layout_height="28dp"
                android:layout_marginStart="4dp" android:text="10" android:textSize="11sp"
                android:gravity="center" android:background="@drawable/arrow_btn_bg" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/btnStep20" android:layout_width="34dp" android:layout_height="28dp"
                android:layout_marginStart="4dp" android:text="20" android:textSize="11sp"
                android:gravity="center" android:background="@drawable/arrow_btn_bg" android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Stop -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnStop"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="Stop Overlay"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:backgroundTint="#CF6679" />

    </LinearLayout>
</LinearLayout>
